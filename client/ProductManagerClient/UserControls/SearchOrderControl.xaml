<UserControl x:Class="ProductManagerClient.UserControls.SearchOrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductManagerClient.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
    
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Αναζήτηση βάσει Χώρας:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSearchCountry" Width="150" Height="25" VerticalContentAlignment="Center"/>
            <Button x:Name="btnSearchCountry" Content="Αναζήτηση" Width="90" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgCountryProducts" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,0,20"/>

       
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Όριο Ασφαλείας Αποθέματος:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtStockLimit" Width="80" Height="25" VerticalContentAlignment="Center"/>
            <Button x:Name="btnFindShortages" Content="Έλεγχος Ελλείψεων" Width="120" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgShortages" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</UserControl>
