<UserControl x:Class="ProductManagerClient.UserControls.AddProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductManagerClient.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode (13 ψηφία):" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtBarcode" Width="200" Height="25" VerticalContentAlignment="Center"/>
            <Button x:Name="btnCheck" Content="Έλεγχος" Width="70" Margin="10,0,0,0" />
            <TextBlock x:Name="lblBarcodeStatus" Text="..." Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Κατηγορία:" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbCategory" Grid.Row="1" Grid.Column="1" Width="200" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15">
            <ComboBoxItem Content="Ηλεκτρονικά" IsSelected="True"/>
            <ComboBoxItem Content="Καλλυντικά"/>
            <ComboBoxItem Content="Αλκοόλ"/>
            <ComboBoxItem Content="Τρόφιμα"/>
            <ComboBoxItem Content="Αναψυκτικά χωρίς αλκοόλ"/>
            <ComboBoxItem Content="Βιβλία"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Απόθεμα (Stock):" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <TextBox x:Name="txtStock" Grid.Row="2" Grid.Column="1" Width="100" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Τιμή Μονάδας (€):" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPrice" Grid.Row="3" Grid.Column="1" Width="100" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Έκπτωση (%):" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDiscount" Grid.Row="4" Grid.Column="1" Width="100" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15" Text="0"/>

        
        <Button x:Name="btnSaveProduct" Grid.Row="7" Grid.Column="1" Content="Καταχώρηση Προϊόντος" Width="180" Height="35" HorizontalAlignment="Left" Margin="173,99,0,-134"  Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>

        
        <TextBlock x:Name="lblSystemMessage" Grid.Row="6" Grid.Column="1" Text="" Foreground="Green" FontWeight="Bold" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
